# Copy this file to .env and fill in real values. Never commit the real .env file.

# Postgres connection string.
# Local docker-compose: postgres://traveluser:travelpass@postgres:5432/travelmap
# Supabase/Neon: the "connection string" they give you in their dashboard
DATABASE_URL=postgres://traveluser:travelpass@localhost:5432/travelmap

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string

# Port the backend listens on
PORT=3001

# Comma-separated list of frontend origins allowed to call this API.
# Use * only for local testing, never in production.
CORS_ORIGIN=*
